{{!
    @template local_leaderboard/rules_table

    Existing points rules table.

    Context variables required for this template:
    * hasrules - bool, whether there is at least one rule row.
    * rows - array of rule rows, each with:
        scope, scopeid, coursename, activityname, activitytype, event, points, deleteurl.

    Example context (json):
    {
        "hasrules": true,
        "rows": [
            {
                "scope": "course",
                "scopeid": 2, 
                "coursename": "Sample course",
                "activityname": "",
                "activitytype": "quiz",
                "event": "attempt_submitted",
                "points": 10,
                "deleteurl": "https://example.com/local/leaderboard/manage_rules.php?delete=1&sesskey=abc"
            }
        ]
    }
}}
<h2>{{existingrulesstr}}</h2>

{{#hasrules}}
<table class="generaltable" style="background-color: #fff;">
    <tr>
        <th>{{#str}}scope, local_leaderboard{{/str}}</th>
        <th>{{#str}}scopeid, local_leaderboard{{/str}}</th>
        <th>{{#str}}course, local_leaderboard{{/str}}</th>
        <th>{{#str}}activity, local_leaderboard{{/str}}</th>
        <th>{{#str}}activitytype, local_leaderboard{{/str}}</th>
        <th>{{#str}}event, local_leaderboard{{/str}}</th>
        <th>{{#str}}points, local_leaderboard{{/str}}</th>
        <th>{{#str}}actions, local_leaderboard{{/str}}</th>
    </tr>
    {{#rows}}
    <tr>
        <td>{{scope}}</td>
        <td>{{scopeid}}</td>
        <td>{{coursename}}</td>
        <td>{{activityname}}</td>
        <td>{{activitytype}}</td>
        <td>{{event}}</td>
        <td>{{points}}</td>
        <td>
            <a href="{{deleteurl}}" onclick="return confirm({{#str}}deletethisrule, local_leaderboard{{/str}})">{{#str}}delete, local_leaderboard{{/str}}</a>
        </td>
    </tr>
    {{/rows}}
</table>
{{/hasrules}}
{{^hasrules}}
<p>{{#str}}noruleyet, local_leaderboard{{/str}}</p>
{{/hasrules}}